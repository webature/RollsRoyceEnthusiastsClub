# Copy to .env / .env.local and fill in real values. See CLAUDE.md for setup steps.
# DATABASE_URL belongs in .env only, never .env.local — see CLAUDE.md's warning about
# Next.js env precedence before adding it there.

# Postgres connection string (local Docker Postgres for dev; Vercel Postgres/Neon in prod).
DATABASE_URL="postgresql://user:password@localhost:5432/rrec?schema=public"

# First admin account, created by `npm run db:seed`. Re-run the seed with new values to add
# another admin. There is no public signup route.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Random secrets used to sign/encrypt the admin and member session cookies (must differ from
# each other). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
MEMBER_SESSION_SECRET=""

# Stripe (test-mode keys for local dev — see dashboard.stripe.com/test/apikeys).
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally, or the
# signing secret of the webhook endpoint configured in the Stripe dashboard in production.
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price IDs for the 4 membership tiers + the one-time joining fee (see CLAUDE.md).
STRIPE_PRICE_E_SINGLE="price_..."
STRIPE_PRICE_E_JOINT="price_..."
STRIPE_PRICE_PAPER_SINGLE="price_..."
STRIPE_PRICE_PAPER_JOINT="price_..."
STRIPE_PRICE_JOINING_FEE="price_..."
